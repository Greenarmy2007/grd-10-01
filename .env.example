# Environment Variables for GRD-10 Nomination Email Pipeline
# Configure these securely in Netlify Site Settings:
# Netlify Dashboard > Site Configuration > Environment Variables

# 1. Your Resend API Key (starts with "re_...")
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Destination email for nomination dossiers to be evaluated by the jury/organizers
NOMINATION_RECIPIENT_EMAIL=jury@example.com

# 3. Verified sender email address configured on your domain in Resend
# (e.g., nominations@updates.yourdomain.com or notifications@grd10.com)
NOMINATION_FROM_EMAIL=GRD-10 Nominations <nominations@yourdomain.com>
